    "#cds-models/*": "./@cds-models/*/index.js"
  },
  "dependencies": {
    "@sap/cds": "^10"
  },
  "devDependencies": {
    "@cap-js/cds-typer": "^0.41.1",
    "@cap-js/cds-types": "^0.18.0",
    "@cap-js/sqlite": "^3",
    "@sap/eslint-plugin-cds": "^4",
    "@types/node": "^24.0.0",
    "eslint": "^10",
    "tsx": "^4",
    "typescript": "^7.0.0"
  }
}
